# Copy this file to .env.local (PowerShell: Copy-Item .env.example .env.local) and fill in your values.
# NEVER commit .env.local or share it: it holds your secrets.

# ---- Restaurant owner account (created automatically the first time the site starts) ----
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=ChangeThisPassword1
OWNER_NAME=Restaurant Owner
OWNER_PHONE=9000000000

# Optional: lets an owner sign up on /signup by typing this secret code. Leave empty to disable
# owner self-registration completely (customers can never become owners without it).
OWNER_INVITE_CODE=

# ---- Restaurant details shown on receipts ----
NEXT_PUBLIC_RESTAURANT_ADDRESS=Vindu Haveli, Your street, Your city, PIN
RESTAURANT_TIMEZONE=Asia/Kolkata

# ---- Database (SQLite file, created automatically) ----
DATABASE_PATH=./storage/vindu-haveli.db

# ---- Login cookie: set to true once your site runs on https:// ----
COOKIE_SECURE=false

# ---- Table booking defaults (the owner can change them later in the dashboard > Settings) ----
DEFAULT_ADVANCE_AMOUNT=200
DEFAULT_BOOKING_DURATION_MIN=90

# ---- Payments (Razorpay) ----
# Leave the three Razorpay values empty to run in clearly-labelled DEMO mode (no real money moves).
# Get keys at https://dashboard.razorpay.com  (use TEST keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional but recommended: webhook secret for https://YOUR-SITE/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=
# Set to false on a live site so demo payments can never be used if keys are missing
ALLOW_DEMO_PAYMENTS=true

# ---- Chatbot ----
# false = answers come from data/faqs.ts (free, no API). true = the chat calls /api/chat (plug an AI in there later).
NEXT_PUBLIC_CHAT_API=false
